find:
SELECT article_id, state, include_full_content, include_images, include_audio, bytes, error_message, updated_at
FROM article_offline_packages
WHERE article_id = :articleID
LIMIT 1;

findByArticleIDs:
SELECT article_id, state, include_full_content, include_images, include_audio, bytes, error_message, updated_at
FROM article_offline_packages
WHERE article_id IN :articleIDs;

findByState:
SELECT article_id, state, include_full_content, include_images, include_audio, bytes, error_message, updated_at
FROM article_offline_packages
WHERE state = :state
ORDER BY updated_at ASC;

findAll:
SELECT article_id, state, include_full_content, include_images, include_audio, bytes, error_message, updated_at
FROM article_offline_packages
ORDER BY updated_at ASC;

upsert:
INSERT INTO article_offline_packages(
  article_id,
  state,
  include_full_content,
  include_images,
  include_audio,
  bytes,
  error_message,
  updated_at
)
VALUES (
  :articleID,
  :state,
  :includeFullContent,
  :includeImages,
  :includeAudio,
  :bytes,
  :errorMessage,
  :updatedAt
)
ON CONFLICT(article_id)
DO UPDATE SET
  state = excluded.state,
  include_full_content = excluded.include_full_content,
  include_images = excluded.include_images,
  include_audio = excluded.include_audio,
  bytes = excluded.bytes,
  error_message = excluded.error_message,
  updated_at = excluded.updated_at;

updateState:
UPDATE article_offline_packages
SET
  state = :state,
  bytes = :bytes,
  error_message = :errorMessage,
  updated_at = :updatedAt
WHERE article_id = :articleID;

delete:
DELETE FROM article_offline_packages
WHERE article_id = :articleID;

deleteByArticleIDs:
DELETE FROM article_offline_packages
WHERE article_id IN :articleIDs;

countByState:
SELECT COUNT(*)
FROM article_offline_packages
WHERE state = :state;

deleteByState:
DELETE FROM article_offline_packages
WHERE state = :state;

deleteAll:
DELETE FROM article_offline_packages;

deleteWithoutArticle:
DELETE FROM article_offline_packages
WHERE article_id NOT IN (
  SELECT id FROM articles
);

protectedReadyIDs:
SELECT p.article_id FROM article_offline_packages p
JOIN articles a ON a.id = p.article_id
JOIN feeds f ON f.id = a.feed_id
LEFT JOIN article_statuses s ON s.article_id = a.id
LEFT JOIN article_reading_progress r ON r.article_id = a.id
WHERE p.state = 'READY'
AND ((:keepStarred = 1 AND s.starred = 1)
  OR (:keepSaved = 1 AND f.read_later = 1)
  OR (:keepFeed = 1 AND f.offline_policy = 'ALWAYS')
  OR (r.updated_at >= :recentSince));
